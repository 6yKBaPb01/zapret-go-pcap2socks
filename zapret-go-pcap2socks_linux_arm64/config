#!/bin/bash
# Zapret Configuration for Linux

# Installation directory (auto-detected, override only if needed)
# ZAPRET_BASE="/opt/zapret"

# Strategy to use (filename from strategies/ without .sh)
# Available: general, general-alt, general-alt2, ..., general-alt11
#           general-fake-tls-auto, general-fake-tls-auto-alt, ...
#           general-simple-fake, general-simple-fake-alt, ...
STRATEGY="general (ALT11).bat"

# NFQUEUE number (must match firewall rules)
QNUM=200

# Mark bit for desync packets (prevents routing loops)
DESYNC_MARK=0x40000000

# Ports configuration
TCP_PORTS="1-65535"
UDP_PORTS="1-65535"

# Game filter mode: off = disabled, tcp = TCP only, udp = UDP only (default), all = TCP+UDP
# Enable for online games that may be affected by DPI
# Enables custom ports (1024-65535) for the selected protocol(s)
GAME_FILTER="all"

# Firewall backend: auto-detected (nftables preferred, iptables fallback)
# Uncomment to override:
# FIREWALL_BACKEND="nftables"

# nftables table name
NFT_TABLE="zapret"

# Run as daemon in background
DAEMON=1

# PID file location
PIDFILE="/run/zapret.pid"

# Log file (empty = no logging)
LOGFILE=""

# Debug mode: 0 = off, 1 = on
DEBUG=0

# IPv6 support: 0 = disabled, 1 = enabled
DISABLE_IPV6=1

# User to run nfqws as (leave empty to run as root)
# WS_USER=""
